# PRODUCTION — npm run build (hoặc build:prod) → dist/
# Chép nội dung dist/ (index.html + assets/) vào thư mục dts/ của 192.168.110.7 → http(s)://192.168.110.7/dts/
# FE và backend cùng origin nên API dùng đường dẫn tương đối: chạy được cả http lẫn https, không cần CORS.
VITE_BASE=/dts/
VITE_API_BASE_URL=/dts/backend/
