# LOCAL — npm run dev: FE ở http://localhost:5173/dts/, gọi backend trên XAMPP của máy dev
# (D:\xampp\htdocs\dts\backend → http://localhost/dts/backend/). Origin localhost:5173 đã có trong CORS của backend.
VITE_BASE=/dts/
VITE_API_BASE_URL=http://localhost/dts/backend/

# Muốn chạy dev nhưng dùng backend STAGING (192.168.110.2) thay vì XAMPP local: bỏ comment 3 dòng dưới.
# Bắt buộc đi qua proxy của Vite: nginx trên NAS chặn mọi request OPTIONS (preflight CORS) bằng 405,
# nên gọi thẳng khác origin kèm header Authorization sẽ luôn hỏng.
# VITE_BASE=/web_develop/dts/
# VITE_API_BASE_URL=/web_develop/dts/backend/
# VITE_PROXY_TARGET=http://192.168.110.2
