# Máy chủ mặc định: `npm run dev` và `npm run build` → http://192.168.110.2/web_develop/dts/
# Máy chủ khác: tạo .env.<mode> ghi đè 2 biến này, build bằng `vite build --mode <mode>` (xem .env.deploy)

# Host của máy chủ (backend + ảnh/video upload)
VITE_ORIGIN=http://192.168.110.2
# Thư mục chứa ứng dụng trên host; backend nằm ở <VITE_BASE>backend/
VITE_BASE=/web_develop/dts/
