# STAGING — npm run build:stg → dist-staging/
# Chép nội dung dist-staging/ (index.html + assets/) vào Z:\web\dts → http(s)://192.168.110.2/web_develop/dts/
# FE và backend cùng origin nên API dùng đường dẫn tương đối: chạy được cả http lẫn https, không cần CORS.
VITE_BASE=/web_develop/dts/
VITE_API_BASE_URL=/web_develop/dts/backend/
